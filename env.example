# ============================================================
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real ".env" file to Git.
# ============================================================

# --- Tailscale ---
TS_HOSTNAME=workspace-hub
TS_DOMAIN=workspace-hub.ten-tailnet.ts.net
TS_AUTHKEY=tskey-auth-khoa-cua-ban-o-day

# --- Authentik (SSO) ---
AUTHENTIK_PG_PASS=change-me-strong-db-password
AUTHENTIK_SECRET_KEY=change-me-50-char-random-secret
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-admin-password
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-bootstrap-token
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

# --- Nextcloud ---
NEXTCLOUD_DB_ROOT_PASS=change-me-root-password
NEXTCLOUD_DB_PASS=change-me-nextcloud-db-password

# --- OnlyOffice ---
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret

# --- Planka ---
PLANKA_PG_PASS=change-me-planka-db-password
PLANKA_SECRET_KEY=change-me-planka-secret-key

# --- AI (llama.cpp / NextChat) ---
LLAMA_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
NEXTCHAT_ACCESS_CODE=change-me-access-code

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key